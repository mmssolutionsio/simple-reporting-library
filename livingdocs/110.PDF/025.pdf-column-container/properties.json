{
  "pdf-column-count": {
    "label": "Number of columns",
    "type": "select",
    "options": [
      {
        "caption": "2 columns (default)"
      },
      {
        "caption": "3 columns",
        "value": "srl-pdf-columns-3"
      }
    ]
  },
  "column-behaviour": {
    "label": "Column behaviour",
    "type": "select",
    "options": [
      {
        "caption": "Balanced (columns of equal height)"
      },
      {
        "caption": "Unbalanced (last column should be empty or shorter)",
        "value": "srl-columns-unbalanced"
      }
    ]
  },
  "pdf-column-reading-order": {
    "label": "PDF reading order",
    "type": "select",
    "options": [
      { "caption": "Standard" },
      {
        "caption": "Column by column around a wide image",
        "value": "srl-pdf-columns-flow-around-image"
      }
    ]
  }
}
