{
  "name": "pdf-element-reference",
  "label": "PDF element reference",
  "description": "Reference to a partial area of a PDF.",
  "properties": [
    "pdf-spacer-before",
    "pdf-spacer-after"
  ],
  "directives": {
    "nswow-pdf": {
      "service": "nswow-pdf"
    },
    "fallback-image": {
      "imageRatios": [
        "1:1",
        "3:2",
        "4:3",
        "16:9",
        "a4"
      ],
      "allowOriginalRatio": true
    }
  }
}
