{
  "name": "image",
  "label": "Image",
  "properties": [
    "width-all",
    "image-position-in-pdf",
    "image-column-span-in-pdf",
    "pdf-spacer"
  ],
  "directives": {
    "show-alt-text": {
      "type": "toggle",
      "label": "Show alt text",
      "default": false
    },
    "show-mobile-image": {
      "type": "toggle",
      "label": "Show mobile image",
      "default": false
    },
    "show-caption": {
      "type": "toggle",
      "label": "Show caption",
      "default": true
    },
    "desktop-image": {
      "imageRatios": ["1:1", "3:2", "4:3", "16:9"],
      "allowOriginalRatio": true
    },
    "mobile-image": {
      "imageRatios": ["1:1", "3:2", "4:3", "16:9"],
      "allowOriginalRatio": true
    }
  }
}
